# StockNest environment
# Leave these empty to use the built-in local file database (web/.data/).
# Fill them in to use Supabase (run supabase/schema.sql in the Supabase SQL editor first).

SUPABASE_URL=
# Server-only key. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=child-photos
